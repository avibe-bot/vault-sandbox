{
  "name": "avibe-vault-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cross-origin crypto sandbox for Avibe Vaults (sandbox.avibe.bot).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/release.mjs check && node scripts/release.mjs assemble",
    "release:stage": "tsc && node scripts/release.mjs stage",
    "release:check": "node scripts/release.mjs check",
    "release:assemble": "node scripts/release.mjs assemble",
    "release:pin": "node scripts/release.mjs pin",
    "release:guard": "node scripts/release.mjs guard",
    "legacy:check": "node scripts/release.mjs legacy-check",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "viem": "2.54.6"
  }
}
